{
  "version": 2,
  "server": {
    "port": 8811,
    "path": "/mcp",
    "service": "free5gc-mcp"
  },
  "tools": [
    {
      "name": "subscriber_list",
      "description": "List every subscriber in this free5GC (SUPI and PLMN; SIM keys are never shown).",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "read_only": true
    },
    {
      "name": "subscriber_get",
      "description": "One subscriber's full profile: slices, DNNs, QoS, AMBR, charging (SIM keys are never shown).",
      "input_schema": {
        "type": "object",
        "properties": {
          "ueId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The subscriber's SUPI, e.g. imsi-208930000000001"
          },
          "servingPlmnId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The serving PLMN id (MCC+MNC), e.g. 20893"
          }
        },
        "required": [
          "ueId",
          "servingPlmnId"
        ],
        "additionalProperties": false
      },
      "read_only": true
    },
    {
      "name": "tenant_users_get",
      "description": "The WebConsole users of a tenant.",
      "input_schema": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The tenant id"
          }
        },
        "required": [
          "tenantId"
        ],
        "additionalProperties": false
      },
      "read_only": true
    },
    {
      "name": "subscriber_create",
      "description": "Create one subscriber. Without subscriberData it gets free5GC's default profile (two slices, DNN internet); key and opc default to free5GC's test keys (UERANSIM's example UEs).",
      "input_schema": {
        "type": "object",
        "properties": {
          "ueId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The subscriber's SUPI, e.g. imsi-208930000000001"
          },
          "servingPlmnId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The serving PLMN id (MCC+MNC), e.g. 20893"
          },
          "key": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{32}$",
            "description": "Permanent key K (optional)"
          },
          "opc": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{32}$",
            "description": "OPc (optional)"
          },
          "subscriberData": {
            "type": "object",
            "description": "A full WebConsole subscriber (optional)"
          }
        },
        "required": [
          "ueId",
          "servingPlmnId"
        ],
        "additionalProperties": false
      },
      "read_only": false
    },
    {
      "name": "subscriber_create_multiple",
      "description": "Create userNumber subscribers with consecutive SUPIs starting at ueId, all with the same profile.",
      "input_schema": {
        "type": "object",
        "properties": {
          "ueId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The subscriber's SUPI, e.g. imsi-208930000000001"
          },
          "servingPlmnId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The serving PLMN id (MCC+MNC), e.g. 20893"
          },
          "userNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "key": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{32}$"
          },
          "opc": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{32}$"
          },
          "subscriberData": {
            "type": "object"
          }
        },
        "required": [
          "ueId",
          "servingPlmnId",
          "userNumber"
        ],
        "additionalProperties": false
      },
      "read_only": false
    },
    {
      "name": "subscriber_update",
      "description": "Replace a subscriber's whole profile with subscriberData.",
      "input_schema": {
        "type": "object",
        "properties": {
          "ueId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The subscriber's SUPI, e.g. imsi-208930000000001"
          },
          "servingPlmnId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The serving PLMN id (MCC+MNC), e.g. 20893"
          },
          "subscriberData": {
            "type": "object"
          }
        },
        "required": [
          "ueId",
          "servingPlmnId",
          "subscriberData"
        ],
        "additionalProperties": false
      },
      "read_only": false
    },
    {
      "name": "subscriber_patch",
      "description": "Change part of a subscriber's profile: patchData is merged into the current profile (e.g. {\"AccessAndMobilitySubscriptionData\": {\"subscribedUeAmbr\": {\"uplink\": \"500 Mbps\"}}}).",
      "input_schema": {
        "type": "object",
        "properties": {
          "ueId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The subscriber's SUPI, e.g. imsi-208930000000001"
          },
          "servingPlmnId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The serving PLMN id (MCC+MNC), e.g. 20893"
          },
          "patchData": {
            "type": "object"
          }
        },
        "required": [
          "ueId",
          "servingPlmnId",
          "patchData"
        ],
        "additionalProperties": false
      },
      "read_only": false
    },
    {
      "name": "subscriber_delete",
      "description": "Delete one subscriber.",
      "input_schema": {
        "type": "object",
        "properties": {
          "ueId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The subscriber's SUPI, e.g. imsi-208930000000001"
          },
          "servingPlmnId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "The serving PLMN id (MCC+MNC), e.g. 20893"
          }
        },
        "required": [
          "ueId",
          "servingPlmnId"
        ],
        "additionalProperties": false
      },
      "read_only": false
    },
    {
      "name": "subscriber_delete_multiple",
      "description": "Delete several subscribers.",
      "input_schema": {
        "type": "object",
        "properties": {
          "subscribers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "ueId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]{1,64}$",
                  "description": "The subscriber's SUPI, e.g. imsi-208930000000001"
                },
                "servingPlmnId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]{1,64}$",
                  "description": "The serving PLMN id (MCC+MNC), e.g. 20893"
                }
              },
              "required": [
                "ueId",
                "servingPlmnId"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "subscribers"
        ],
        "additionalProperties": false
      },
      "read_only": false
    }
  ]
}
